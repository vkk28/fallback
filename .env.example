# Server-side RPC. Public testnet endpoint; replace with a private service if needed.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# Fill only after deployment and onchain verification. Never use a guessed address.
FACTORY_ADDRESS=
TOKEN_ADDRESS=
# Test-only token is Fallback Test Token (FBTEST), 6 decimals, no real value.
# Phase 2: configure in Privy dashboard; enable Monad Testnet and sponsorship.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_SERVER_SPONSORSHIP_ENABLED=false
INVITATION_TOKEN_KEY=
APP_ORIGIN=http://localhost:3000
# Later phases: private PostgreSQL, Envio endpoint, dedicated permissionless worker.
DATABASE_URL=
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_SECRET=
ENVIO_API_TOKEN=
WORKER_PRIVATE_KEY=
CRE_RELAY_SECRET=
DEPLOYMENT_START_BLOCK=0
# No secret value belongs in NEXT_PUBLIC_* or source control.
