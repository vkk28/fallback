# Server-side RPC. Public testnet endpoint; replace with a private service if needed.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# Fill only after deployment and onchain verification. Never use a guessed address.
FACTORY_ADDRESS=
TOKEN_ADDRESS=
# Test-only token is Fallback Test Token (FBTEST), 6 decimals, no real value.
# Phase 2: configure in Privy dashboard; enable Monad Testnet and sponsorship.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_SERVER_SPONSORSHIP_ENABLED=false
INVITATION_TOKEN_KEY=
# Optional consented email delivery. Server-only keys; no automatic sending.
# Random 32-byte AES key encoded as 64 lowercase hex characters; retain for retries.
INVITATION_DELIVERY_KEY=
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
# Reachable HTTPS app origin required for emailed links; localhost cannot be emailed.
INVITATION_APP_ORIGIN=
APP_ORIGIN=http://localhost:3000
# Later phases: private PostgreSQL, Envio endpoint, dedicated permissionless worker.
DATABASE_URL=
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_SECRET=
ENVIO_API_TOKEN=
WORKER_PRIVATE_KEY=
# Netlify-only batch worker: keep disabled until private state is restored and the
# previous worker is stopped. Random server-only trigger secret, at least32chars.
HOSTED_WORKER_ENABLED=false
WORKER_TRIGGER_SECRET=
CRE_RELAY_SECRET=
# Server/private backup key; retain an independent protected recovery copy.
BACKUP_ENCRYPTION_KEY=
# Enable only after heartbeat migration and hosted health endpoint rollout.
HEALTH_MONITOR_ENABLED=false
DEPLOYMENT_START_BLOCK=0
# No secret value belongs in NEXT_PUBLIC_* or source control.
