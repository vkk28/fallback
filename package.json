{
  "name": "fallback",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint:app": "eslint apps/web/app packages/backend/src packages/domain/src apps/worker/src indexer/src workflows/cre/*.ts scripts --max-warnings 0",
    "web:dev": "node scripts/web.mjs dev --hostname 127.0.0.1",
    "web:start": "node scripts/web.mjs start --hostname 127.0.0.1",
    "web:build": "node scripts/generate-icons.mjs && node scripts/web.mjs build --webpack",
    "web:typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:backup-local": "node --env-file-if-exists=.env --import tsx scripts/backup-local.ts",
    "db:seal-backup": "node --env-file-if-exists=.env --import tsx scripts/backup-seal.ts",
    "db:test-indexer-restore": "node --env-file-if-exists=.env --import tsx scripts/restore-indexer-backup.ts",
    "db:local": "node scripts/postgres-local.mjs",
    "test:postgres": "node --env-file-if-exists=.env --import tsx scripts/postgres-verification.ts",
    "test:worker-chain": "node --import tsx scripts/local-worker-verification.ts",
    "test:cre-batch": "node --import tsx scripts/local-worker-verification.ts --cre-batch",
    "scan:client-secrets": "node scripts/scan-client-secrets.mjs",
    "scan:source": "node scripts/scan-source.mjs",
    "verify:live-actions": "node --env-file-if-exists=.env --import tsx scripts/verify-live-actions.ts",
    "verify:functionality": "node --env-file-if-exists=.env --import tsx scripts/verify-functionality.ts",
    "verify:pending-actions": "node --env-file-if-exists=.env --import tsx scripts/verify-pending-actions.ts",
    "verify:funding-recovery": "node --env-file-if-exists=.env --import tsx scripts/verify-funding-recovery.ts",
    "verify:indexer-live": "node --env-file-if-exists=.env --import tsx scripts/verify-indexer-live.ts",
    "test:indexer-restart": "node --env-file-if-exists=.env --import tsx scripts/verify-indexer-restart.ts",
    "test:indexer-reorg": "node --env-file-if-exists=.env --import tsx scripts/local-indexer-reorg.ts",
    "chain:manifest": "node --env-file-if-exists=.env scripts/deployment-manifest.mjs",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.tools/browsers playwright test",
    "indexer:configure": "node --env-file-if-exists=.env scripts/indexer-config.mjs",
    "graphql:prepare": "node --import tsx scripts/graphql-local.ts prepare",
    "graphql:start": "node --import tsx scripts/graphql-local.ts start",
    "graphql:status": "node --import tsx scripts/graphql-local.ts status",
    "graphql:verify-reader": "node --import tsx scripts/graphql-readiness.ts",
    "graphql:stop": "node --import tsx scripts/graphql-local.ts stop",
    "indexer:codegen": "node --env-file-if-exists=.env node_modules/envio/bin.mjs -d indexer codegen",
    "indexer:typecheck": "tsc --noEmit -p indexer/tsconfig.json",
    "indexer:verify": "node scripts/indexer-config.mjs --local-fixture && ENVIO_CONFIG=config.fixture.yaml node node_modules/envio/bin.mjs -d indexer codegen && tsc --noEmit -p indexer/tsconfig.fixture.json && cd indexer && ENVIO_CONFIG=config.fixture.yaml node --import tsx src/verify.ts",
    "cre:typecheck": "tsc --noEmit -p workflows/cre/tsconfig.json",
    "cre:test": "bun test workflows/cre/main.test.ts",
    "cre:simulate": "node --import tsx scripts/cre-simulate.ts",
    "cre:execute": "node --import tsx scripts/cre-simulate.ts --require-work",
    "cre:deploy-private": "node --import tsx scripts/cre-deploy.ts",
    "cre:staging-local": "node --import tsx scripts/staging-relay.ts",
    "cre:staging-tool": "node scripts/install-cloudflared.mjs",
    "cre:staging-publish": "node scripts/cre-staging-tunnel.mjs",
    "cre:build": "bun node_modules/@chainlink/cre-sdk/bin/cre-compile.ts workflows/cre/main.ts workflows/cre/main.wasm",
    "compiler:install": "node scripts/install-solc.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/foundry.mjs lint --severity high med --deny warnings",
    "test": "vitest run",
    "contracts:build": "node scripts/foundry.mjs build --force",
    "contracts:test": "node scripts/foundry.mjs test --force -vv",
    "contracts:fmt": "node scripts/foundry.mjs fmt --check",
    "contracts:format": "node scripts/foundry.mjs fmt",
    "contracts:slither": "node scripts/slither.mjs",
    "contracts:prepare-verification": "node --env-file-if-exists=.env scripts/prepare-explorer-verification.mjs",
    "chain:local": "node scripts/anvil.mjs",
    "chain:abis": "node scripts/generate-abis.mjs",
    "chain:verify": "node --env-file-if-exists=.env scripts/verify-network.mjs",
    "test:local-chain": "node scripts/local-integration.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm contracts:fmt && pnpm lint && pnpm contracts:test && pnpm chain:abis",
    "services:start": "node scripts/local-services.mjs start",
    "services:status": "node scripts/local-services.mjs status",
    "services:stop": "node scripts/local-services.mjs stop"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.23.0",
    "@hookform/resolvers": "5.4.0",
    "@openzeppelin/contracts": "5.4.0",
    "@privy-io/node": "0.35.0",
    "@privy-io/react-auth": "3.48.0",
    "@serwist/next": "9.5.13",
    "@tanstack/react-query": "5.104.1",
    "drizzle-orm": "0.45.3",
    "envio": "3.14.0",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "serwist": "9.5.13",
    "viem": "2.57.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
